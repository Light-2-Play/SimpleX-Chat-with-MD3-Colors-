@Composable
fun SingBoxShieldButton(
    isConnected: Boolean,
    onClick: () -> Unit,
    modifier: Modifier = Modifier
) {
    // Динамические цвета Monet / темы
    val activeColor = MaterialTheme.colors.primary
    val inactiveColor = MaterialTheme.colors.onSurface.copy(alpha = 0.6f)
    
    val tintColor by animateColorAsState(
        targetValue = if (isConnected) activeColor else inactiveColor,
        animationSpec = tween(250)
    )

    IconButton(
        onClick = onClick,
        modifier = modifier
    ) {
        Icon(
            painter = painterResource(MR.images.ic_shield_shield_bolt),
            contentDescription = "SingBox VPN",
            tint = tintColor,
            modifier = Modifier.size(24.dp)
        )
    }
}
